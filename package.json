{
  "name": "deployforge",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:push": "pnpm exec prisma db push --schema prisma/schema.prisma",
    "db:generate": "pnpm exec prisma generate --schema prisma/schema.prisma",
    "db:studio": "pnpm exec prisma studio --schema prisma/schema.prisma",
    "db:migrate": "pnpm exec prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "pnpm exec prisma migrate dev --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.1",
    "prisma": "^7.10.1",
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.15.0"
}
