{
  "name": "deployforge",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:push": "pnpm exec prisma db push --schema prisma/schema.prisma",
    "db:generate": "pnpm exec prisma generate --schema prisma/schema.prisma",
    "db:studio": "pnpm exec prisma studio --schema prisma/schema.prisma",
    "db:migrate": "pnpm exec prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "pnpm exec prisma migrate dev --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "prisma": "^7.10.0",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@8.15.4",
  "pnpm": {
    "overrides": {
      "@fastify/busboy": "3.2.2",
      "baseline-browser-mapping": "2.11.0",
      "browserslist": "4.28.7",
      "deepmerge-ts": "8.0.0",
      "fast-uri": "3.1.8",
      "mysql2": "3.23.1",
      "source-map-js": "1.2.2",
      "ws": "8.21.0"
    }
  }
}
